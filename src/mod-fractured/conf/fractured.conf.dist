#
# Fractured module — Step 2 stubs. Behavior lands in later steps.
# Copy to the run-dir conf (live/ or dev/) as fractured.conf when the
# worldserver exists. Do not put secrets in git.
#

[worldserver]

#
# Fractured.Enable
# Description: Load Fractured scripts (meters, Gate, death). Stubs only.
# Default:     1 (enabled)
#

Fractured.Enable = 1

#
# Fractured.Gate.BlockBots
# Description: Refuse playerbots at the Gate (L11). Stub until playerbots
#              is on the Fractured server; the hook still runs.
# Default:     1
#

Fractured.Gate.BlockBots = 1
